%% Hybrid edge/cloud demo: actual deployed architecture (one k3d cluster, two namespaces)
%% Render: https://mermaid.live  or
%%   docker run --rm -u $(id -u):$(id -g) -v $PWD/docs:/data minlag/mermaid-cli -i /data/architecture.mmd -o /data/architecture.png -s 3 -b white
flowchart LR
  classDef edgeNode fill:#e8f4ea,stroke:#2e7d32,color:#1b3d1f
  classDef cloudNode fill:#e6effa,stroke:#1565c0,color:#0d2a4d
  classDef linkNode fill:#fff3e0,stroke:#e65100,color:#4a2400,stroke-width:3px
  classDef store fill:#f5f5f5,stroke:#757575,color:#333,stroke-dasharray: 4 3
  classDef actor fill:#fafafa,stroke:#424242,color:#222

  subgraph host["Laptop: Docker + k3d cluster 'edge-cloud' (1 node)"]
    subgraph edge["EDGE SITE: namespace edge"]
      sim["<b>sensor-sim</b><br/>100 Hz vibration<br/>host :8080 POST /burst"]:::edgeNode
      mq["<b>mosquitto</b><br/>MQTT broker"]:::edgeNode
      agg["<b>edge-aggregator</b><br/>10 s window stats<br/>local alert: 1 s RMS &gt; 1.5<br/>host :8000 /metrics"]:::edgeNode
      pe["<b>prometheus-edge</b><br/>agent mode, scrape 2 s<br/>label site=edge-1"]:::edgeNode
      wal[("WAL buffer")]:::store

      sim -- "raw ~100 msg/s" --> mq
      mq -- "raw" --> agg
      mq -. "burst cmd" .-> sim
      pe -- "scrape /metrics" --> agg
      pe --- wal
    end

    link{{"<b>edge-link</b> (Toxiproxy)<br/>THE WAN LINK<br/>host :8474 API"}}:::linkNode

    subgraph cloud["CLOUD SITE: namespace cloud"]
      pc["<b>prometheus-cloud</b><br/>remote-write receiver<br/>host :9090"]:::cloudNode
      pvc[("PVC 1 Gi<br/>history")]:::store
      gr["<b>grafana</b><br/>host :3000"]:::cloudNode
      pc --- pvc
      pc -- "PromQL" --> gr
    end

    pe == "remote_write<br/>store-and-forward" ==> link
    link == "aggregates only<br/>~1/1000 of raw" ==> pc

    chaos(["demo scripts<br/>cut link / +2 s latency<br/>scale cloud to 0"]):::actor
    chaos -. ":8474" .-> link
    chaos -. "kubectl" .-> pc
  end


  style edge fill:#f3faf4,stroke:#2e7d32,stroke-width:2px
  style cloud fill:#f2f7fd,stroke:#1565c0,stroke-width:2px
  style host fill:#ffffff,stroke:#9e9e9e,stroke-dasharray: 6 4
